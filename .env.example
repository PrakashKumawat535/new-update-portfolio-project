# API server only — never prefix private values with VITE_
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster>/<database>?retryWrites=true&w=majority
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-at-least-48-random-characters
ADMIN_EMAIL=your-admin-email@example.com
# Set a unique initial password with 14+ chars, upper/lowercase, number and symbol. Change it after first login.
ADMIN_PASSWORD=ReplaceThis-With-A-Unique-Password!9
# Optional secure image uploads (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional Gemini chatbot (keep this only on the API server)
GEMINI_API_KEY=
# Optional Google Apps Script Web App endpoint for inquiry mirroring; MongoDB remains primary storage
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
# Frontend only; set to API base URL in production, e.g. https://your-api.onrender.com
VITE_API_BASE_URL=http://localhost:5000
